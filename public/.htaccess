# AfghanTours Apache / cPanel static hosting
# Production MUST use this public/.htaccess (copied into dist/ on build).
# PHP inquiry: public/tour-inquiry.php requires PHP execution; static-only hosts need PUBLIC_FORM_ENDPOINT.
#

# BEGIN AFGHANTOURS-HAND
# Hand-maintained host rules (preserved across regenerate). Add carefully.
# END AFGHANTOURS-HAND

# BEGIN AFGHANTOURS-REDIRECT-MAP
# Auto-generated from docs/redirect-map.csv — do not edit by hand.
# Regenerate: node scripts/generate-htaccess.mjs
# Deploy this file with static dist/ on Apache/cPanel. Nginx needs equivalent map.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Align repo alias with live Transportation URL; content reused from getting-around scaffold
  RewriteRule ^getting-around/?$ /transportation/ [R=301,L]
  # Live Faizabad hub slug → repo hub slug
  RewriteRule ^hubs/faizabad-city/?$ /hubs/faizabad/ [R=301,L]
  # Historical Sample.html not found in zip1 or workspace packages — flag; confirm via cpanel-final / html-handoff when atta
  RewriteRule ^Sample\.html/?$ - [G,L]
  # Case variant of Sample.html — same status
  RewriteRule ^sample\.html/?$ - [G,L]
  # Live restaurants URL is broken Apache autoindex; zip1 had restaurants routes — do not advertise until rebuilt
  RewriteRule ^restaurants/?$ - [G,L]
  # Founder alias → founder story
  RewriteRule ^founder/?$ /story/ [R=301,L]
  # Empty partnership story alias → founder story
  RewriteRule ^partnership/?$ /story/ [R=301,L]
