---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
  /** Soft invert for navy bands */
  onDark?: boolean;
}
const { eyebrow, title, subtitle, centered = false, onDark = false } = Astro.props;
const alignClass = centered ? 'text-center items-center' : 'text-left items-start';
const eyebrowClass = onDark
  ? 'text-xs font-semibold uppercase tracking-[0.14em] text-[#e8c56a]'
  : 'text-xs font-semibold uppercase tracking-[0.14em] text-[#b88a2a]';
const titleClass = onDark
  ? 'font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-tight'
  : 'font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-[#1e3a5f] leading-tight';
const subClass = onDark
  ? `text-sm sm:text-base text-white/75 leading-relaxed ${centered ? 'max-w-xl' : 'max-w-2xl'}`
  : `text-sm sm:text-base text-[rgba(15,23,42,0.65)] leading-relaxed ${centered ? 'max-w-xl' : 'max-w-2xl'}`;
---

<div class={`flex flex-col gap-2 ${alignClass}`}>
  {eyebrow && (
    <span class={eyebrowClass}>
      {eyebrow}
    </span>
  )}
  <h2 class={titleClass}>
    {title}
  </h2>
  {subtitle && (
    <p class={subClass}>
      {subtitle}
    </p>
  )}
</div>
