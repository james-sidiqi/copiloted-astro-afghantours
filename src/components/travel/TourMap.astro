---
import type { MapStop } from '@lib/types/view-models';

interface Props {
  stops: MapStop[];
  tourName?: string;
}

const { stops, tourName = 'Tour Route' } = Astro.props;
const validStops = stops.filter((s) => s.lat !== 0 && s.lng !== 0);

/** Sequential compact path (day order) — avoids geographic line crossings / overlapping labels. */
const width = 960;
const height = 220;
const padX = 56;
const padY = 72;
const n = validStops.length;
const step = n > 1 ? (width - padX * 2) / (n - 1) : 0;

const plottedStops = validStops.map((stop, index) => {
  const x = n === 1 ? width / 2 : padX + index * step;
  const y = padY + (index % 2 === 0 ? 0 : 28);
  return {
    ...stop,
    x: Number(x.toFixed(2)),
    y: Number(y.toFixed(2)),
  };
});

const polylinePoints = plottedStops.map((stop) => `${stop.x},${stop.y}`).join(' ');
const provinceSummary = [...new Set(plottedStops.map((stop) => stop.province).filter(Boolean))];
const categorySummary = [...new Set(plottedStops.map((stop) => stop.category).filter(Boolean))];

/** Short label for SVG — full name lives in the day list. */
function shortLabel(name: string): string {
  if (name.length <= 18) return name;
  return `${name.slice(0, 16)}…`;
}
---

{plottedStops.length > 0 ? (
  <div class="overflow-hidden rounded-[28px] border border-[#1e3a5f]/10 bg-white shadow-[0_14px_40px_rgba(15,23,42,0.08)]">
    <div class="border-b border-[#1e3a5f]/10 bg-[linear-gradient(135deg,#1e3a5f_0%,#244a72_48%,#2c5f8b_100%)] px-6 py-5 text-white sm:px-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#d9c08a]">Schematic route map</p>
          <h3 class="mt-2 font-display text-2xl font-semibold leading-tight">Route overview for {tourName}</h3>
          <p class="mt-2 max-w-2xl text-sm text-white/80">
            Schematic day-order connections — not proven roads and not drive-time estimates. Readable on mobile without crossing lines.
          </p>
        </div>

        <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
          <div class="rounded-2xl bg-white/10 px-4 py-3 backdrop-blur-sm">
            <dt class="text-[11px] uppercase tracking-[0.18em] text-white/60">Stops</dt>
            <dd class="mt-1 text-lg font-semibold text-white">{plottedStops.length}</dd>
          </div>
          <div class="rounded-2xl bg-white/10 px-4 py-3 backdrop-blur-sm">
            <dt class="text-[11px] uppercase tracking-[0.18em] text-white/60">Provinces</dt>
            <dd class="mt-1 text-lg font-semibold text-white">{provinceSummary.length}</dd>
          </div>
          <div class="rounded-2xl bg-white/10 px-4 py-3 backdrop-blur-sm col-span-2 sm:col-span-1">
            <dt class="text-[11px] uppercase tracking-[0.18em] text-white/60">Journey</dt>
            <dd class="mt-1 text-lg font-semibold text-white">Day-by-day</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="grid gap-0 lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,1fr)]">
      <!-- Day list first on mobile for readability -->
      <div class="order-2 bg-[#f8fafc] p-5 sm:p-6 lg:order-2 lg:border-l lg:border-[#1e3a5f]/10">
        <div class="flex flex-wrap gap-2">
          {provinceSummary.map((province) => (
            <span class="rounded-full bg-[#1f4aa8]/8 px-3 py-1 text-xs font-medium text-[#1e3a5f]">
              {province}
            </span>
          ))}
        </div>

        {categorySummary.length > 0 && (
          <p class="mt-4 text-sm text-[rgba(15,23,42,0.58)]">
            Highlights include {categorySummary.join(', ').toLowerCase()}.
          </p>
        )}

        <ol class="mt-5 space-y-2.5">
          {plottedStops.map((stop) => (
            <li class="rounded-2xl border border-[#1e3a5f]/10 bg-white p-3.5 shadow-sm">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#1f4aa8] text-sm font-bold text-white">
                  {stop.stopNumber}
                </span>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <p class="font-semibold text-[#1e3a5f] text-sm sm:text-base">{stop.name}</p>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[#b88a2a]">
                      Day {stop.dayNumber}
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-[rgba(15,23,42,0.5)]">
                    {stop.province} · {stop.category}
                  </p>
                  {stop.descShort && (
                    <p class="mt-1.5 text-sm leading-relaxed text-[rgba(15,23,42,0.7)] line-clamp-2">{stop.descShort}</p>
                  )}
                  <a
                    href={`/attractions/${stop.slug}`}
                    class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-[#1f4aa8] transition hover:text-[#16397f]"
                  >
                    View attraction
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="order-1 border-b border-[#1e3a5f]/10 bg-[radial-gradient(circle_at_top,_rgba(184,138,42,0.12),_transparent_35%),linear-gradient(180deg,#f8fafc_0%,#eef4fb_100%)] p-4 sm:p-5 lg:order-1 lg:border-b-0">
        <div class="overflow-x-auto rounded-[20px] border border-white/60 bg-white/70 shadow-inner shadow-[#1e3a5f]/5">
          <svg
            viewBox={`0 0 ${width} ${height}`}
            class="h-auto w-full min-w-[320px]"
            role="img"
            aria-label={`Compact day-order route with ${plottedStops.length} stops for ${tourName}`}
          >
            <defs>
              <linearGradient id="route-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#1f4aa8"></stop>
                <stop offset="100%" stop-color="#b88a2a"></stop>
              </linearGradient>
            </defs>

            <text x={padX} y="28" font-size="13" font-weight="700" fill="#1e3a5f">
              Schematic path (day order)
            </text>
            <text x={padX} y="46" font-size="11" fill="rgba(30,58,95,0.62)">
              Schematic links only · numbers match the stop list · not verified road geometry.
            </text>

            {polylinePoints && (
              <polyline
                points={polylinePoints}
                fill="none"
                stroke="url(#route-gradient)"
                stroke-width="6"
                stroke-linecap="round"
                stroke-linejoin="round"
                opacity="0.9"
              ></polyline>
            )}

            {plottedStops.map((stop, index) => (
              <g>
                <circle
                  cx={stop.x}
                  cy={stop.y}
                  r="16"
                  fill="#1f4aa8"
                  stroke="#ffffff"
                  stroke-width="4"
                ></circle>
                <text
                  x={stop.x}
                  y={stop.y + 1}
                  text-anchor="middle"
                  dominant-baseline="middle"
                  font-size="12"
                  font-weight="700"
                  fill="#ffffff"
                >
                  {stop.stopNumber}
                </text>
                {/* Alternating short labels above/below — spaced for mobile readability */}
                <text
                  x={stop.x}
                  y={index % 2 === 0 ? stop.y - 28 : stop.y + 36}
                  text-anchor="middle"
                  font-size="11"
                  font-weight="600"
                  fill="#1e3a5f"
                >
                  {shortLabel(stop.name)}
                </text>
              </g>
            ))}
          </svg>
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="flex h-32 w-full items-center justify-center rounded-2xl border border-[#1e3a5f]/10 bg-[#1e3a5f]/5 text-sm italic text-[rgba(15,23,42,0.45)]">
    Map not available for this tour.
  </div>
)}
