---
import SafeImage from '@components/ui/SafeImage.astro';
import type {
  Dish,
  HotelProperty,
  ItineraryDay,
  Location,
  Province,
  TransportOption,
} from '@lib/types/view-models';

interface LinkedItem {
  key: string;
  type: string;
  label: string;
  href?: string;
  description?: string;
  context?: string;
  imagePath?: string;
}

interface Props {
  days: ItineraryDay[];
  hubs: Location[];
  provinces: Province[];
  hotels: HotelProperty[];
  dishes: Dish[];
  transports: TransportOption[];
  tourTransportNote?: string;
}

const { days, hubs, provinces, hotels, dishes, transports, tourTransportNote = '' } = Astro.props;

const provinceByCode = new Map(provinces.map((p) => [p.provinceCode, p]));
const hubByCode = new Map(hubs.map((h) => [h.locationCode, h]));
const transportWords = new Set(tourTransportNote.toLowerCase().split(/[^a-z0-9]+/).filter(Boolean));

const fallbackByType: Record<string, string> = {
  attraction: '/assets/images/placeholders/default-attraction.webp',
  hub: '/assets/images/placeholders/default-region.webp',
  province: '/assets/images/placeholders/default-region.webp',
  hotel: '/assets/images/placeholders/default-hotel.webp',
  dish: '/assets/images/placeholders/default-food.webp',
  transport: '/assets/images/placeholders/default-card.webp',
};

const dayItems = days.map((day) => {
  const attractions: LinkedItem[] = day.attractions.map((attraction) => ({
    key: `attraction-${day.dayNumber}-${attraction.attractionCode}`,
    type: 'attraction',
    label: attraction.name,
    href: `/attractions/${attraction.slug}`,
    description: attraction.descShort,
    context: attraction.province ? `${attraction.province} Province` : undefined,
    imagePath: attraction.thumbnailPath || attraction.imagePath,
  }));

  const hubCodes = new Set(
    day.attractions.map((a) => a.locationCode).filter((code): code is string => Boolean(code))
  );
  const locationHub = hubs.find((hub) => hub.name.toLowerCase() === day.location.toLowerCase());
  if (locationHub) hubCodes.add(locationHub.locationCode);

  const dayHubs: LinkedItem[] = Array.from(hubCodes)
    .map((code) => hubByCode.get(code))
    .filter((hub): hub is Location => Boolean(hub))
    .map((hub) => {
      const province = provinceByCode.get(hub.parentCode);
      return {
        key: `hub-${day.dayNumber}-${hub.locationCode}`,
        type: 'hub',
        label: hub.name,
        href: `/destinations/${hub.slug}`,
        context: province ? `${province.provinceName} Province` : undefined,
        imagePath: province?.squareImagePath || province?.coverImagePath,
      };
    });

  const provinceCodes = new Set(day.attractions.map((a) => a.provinceCode).filter(Boolean));
  if (locationHub?.parentCode) provinceCodes.add(locationHub.parentCode);
  const dayProvinces: LinkedItem[] = Array.from(provinceCodes)
    .map((code) => provinceByCode.get(code))
    .filter((province): province is Province => Boolean(province))
    .map((province) => ({
      key: `province-${day.dayNumber}-${province.provinceCode}`,
      type: 'province',
      label: `${province.provinceName} Province`,
      href: `/provinces/${province.provinceSlug}`,
      description: province.shortBlurb,
      imagePath: province.squareImagePath || province.coverImagePath,
    }));

  const dayHotels: LinkedItem[] = Array.from(hubCodes)
    .flatMap((hubCode) => hotels.filter((hotel) => hotel.destinationsCode === hubCode))
    .filter((hotel, idx, arr) => arr.findIndex((h) => h.hotelId === hotel.hotelId) === idx)
    .map((hotel) => ({
      key: `hotel-${day.dayNumber}-${hotel.hotelId}`,
      type: 'hotel',
      label: hotel.hotelName,
      description: hotel.description,
      context: `${hotel.tier} · $${hotel.perNightPriceFrom.toLocaleString()}/night`,
      imagePath: hotel.imagePaths.find(Boolean),
    }));

  const dayDishes: LinkedItem[] = Array.from(hubCodes)
    .flatMap((hubCode) => dishes.filter((dish) => dish.destinationCode === hubCode))
    .filter((dish, idx, arr) => arr.findIndex((d) => d.dishCode === dish.dishCode) === idx)
    .map((dish) => ({
      key: `dish-${day.dayNumber}-${dish.dishCode}`,
      type: 'dish',
      label: dish.name,
      href: `/food-culture/${dish.slug}`,
      description: dish.descShort,
      context: dish.category || dish.mealType,
      imagePath: dish.imagePath,
    }));

  const dayTransports: LinkedItem[] = transports
    .filter((transport) => {
      if (transport.routeGroupId === 'ALL_LOCATIONS') return true;
      return (
        transportWords.has(transport.vehicleType.toLowerCase()) ||
        transportWords.has(transport.transportSlug.toLowerCase())
      );
    })
    .slice(0, 4)
    .map((transport) => ({
      key: `transport-${day.dayNumber}-${transport.transportId}`,
      type: 'transport',
      label: transport.transportName,
      description: transport.logicNotes,
      context: `${transport.minPax}–${transport.maxPax} travellers`,
    }));

  const ordered = [attractions, dayHubs, dayProvinces, dayHotels, dayDishes, dayTransports].flat();
  const defaultItem = ordered[0];

  return {
    day,
    groups: [
      { label: 'Attractions', items: attractions },
      { label: 'Hubs', items: dayHubs },
      { label: 'Provinces', items: dayProvinces },
      { label: 'Hotels', items: dayHotels },
      { label: 'Food & Culture', items: dayDishes },
      { label: 'Transport', items: dayTransports },
    ],
    defaultItemKey: defaultItem?.key ?? '',
    hasItems: ordered.length > 0,
  };
});
---

<ol class="relative border-l-2 border-[#1f4aa8]/20 ml-4 space-y-0">
  {dayItems.map(({ day, groups, defaultItemKey, hasItems }) => (
    <li class="relative pb-10 last:pb-0 pl-8">
      <span class="absolute -left-[13px] top-1 flex items-center justify-center w-6 h-6 rounded-full bg-[#1f4aa8] text-white text-xs font-bold ring-4 ring-[#f6f7fb]">
        {day.dayNumber}
      </span>

      <section class="bg-white rounded-[14px] shadow-[0_2px_16px_0_rgba(0,0,0,0.06)] p-4 sm:p-5 js-itinerary-day" data-default-key={defaultItemKey}>
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-6">
          <div>
            <div class="flex flex-wrap items-start gap-2 mb-3">
              <span class="text-xs font-semibold uppercase tracking-wider text-[#b88a2a]">Day {day.dayNumber}</span>
              {day.location && (
                <span class="text-xs text-[rgba(15,23,42,0.5)]">{day.location}</span>
              )}
            </div>

            <h4 class="font-display text-sm sm:text-base font-semibold text-[#1e3a5f] leading-snug mb-2">
              {day.title || `Day ${day.dayNumber} Highlights`}
            </h4>

            {day.description && (
              <p class="text-sm text-[rgba(15,23,42,0.72)] leading-relaxed mb-3">{day.description}</p>
            )}

            {day.flightId && (
              <div class="text-xs text-[#1f4aa8] font-medium bg-[#1f4aa8]/5 rounded-lg px-3 py-2 mb-3">
                Flight: {day.flightId}
              </div>
            )}

            {day.driveTimeNotes && (
              <p class="text-xs text-[rgba(15,23,42,0.5)] italic mb-4">{day.driveTimeNotes}</p>
            )}

            <div class="space-y-3">
              {groups
                .filter((group) => group.items.length > 0)
                .map((group) => (
                  <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.13em] text-[rgba(15,23,42,0.45)] mb-2">{group.label}</p>
                    <div class="flex flex-wrap gap-2.5">
                      {group.items.map((item) => (
                        <button
                          type="button"
                          class="js-preview-trigger text-sm text-[#8a651e] hover:text-[#1f4aa8] underline underline-offset-2 decoration-[#b88a2a] hover:decoration-[#1f4aa8] transition-colors"
                          data-preview-key={item.key}
                        >
                          {item.label} →
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
            </div>
          </div>

          {hasItems && (
            <aside class="lg:sticky lg:top-24 self-start">
              <div class="space-y-3">
                {groups.flatMap((group) =>
                  group.items.map((item) => (
                    <article
                      class="js-preview-card hidden rounded-xl border border-[#1e3a5f]/10 bg-[#f8fafc] overflow-hidden"
                      data-preview-key={item.key}
                    >
                      <div class="aspect-[16/10] bg-gray-100">
                        <SafeImage
                          src={item.imagePath}
                          fallback={fallbackByType[item.type] ?? '/assets/images/placeholders/default-card.webp'}
                          alt={item.label}
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                      <div class="p-4">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.13em] text-[#b88a2a]">{item.type}</p>
                        <h5 class="font-display text-base font-semibold text-[#1e3a5f] mt-1">{item.label}</h5>
                        {item.context && <p class="text-xs text-[rgba(15,23,42,0.55)] mt-1">{item.context}</p>}
                        {item.description && <p class="text-sm text-[rgba(15,23,42,0.7)] mt-2 line-clamp-3">{item.description}</p>}
                        {item.href && (
                          <a href={item.href} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-[#1f4aa8] hover:text-[#16397f]">
                            Open full page <span aria-hidden="true">→</span>
                          </a>
                        )}
                      </div>
                    </article>
                  ))
                )}
              </div>
            </aside>
          )}
        </div>
      </section>
    </li>
  ))}
</ol>

<script>
  document.querySelectorAll<HTMLElement>('.js-itinerary-day').forEach((dayEl) => {
    const cards = Array.from(dayEl.querySelectorAll<HTMLElement>('.js-preview-card'));
    const buttons = Array.from(dayEl.querySelectorAll<HTMLButtonElement>('.js-preview-trigger'));
    if (!cards.length) return;

    const activate = (key: string) => {
      cards.forEach((card) => card.classList.toggle('hidden', card.dataset.previewKey !== key));
      buttons.forEach((button) => {
        const active = button.dataset.previewKey === key;
        button.classList.toggle('text-[#1f4aa8]', active);
        button.classList.toggle('font-semibold', active);
      });
    };

    const initialKey = dayEl.dataset.defaultKey || cards[0]?.dataset.previewKey || '';
    if (initialKey) activate(initialKey);

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.previewKey || '';
        if (key) activate(key);
      });
    });
  });
</script>
