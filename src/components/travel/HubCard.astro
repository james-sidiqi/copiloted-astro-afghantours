---
import SafeImage from '@components/ui/SafeImage.astro';

interface Props {
  hub: import('@lib/types/view-models').Location;
  provinceName: string;
  imagePath?: string;
}
const { hub, provinceName, imagePath = '' } = Astro.props;
---

<article class="group bg-white rounded-[14px] shadow-[0_2px_16px_0_rgba(0,0,0,0.08)] hover:shadow-[0_10px_30px_rgba(15,23,42,0.08)] transition-shadow duration-300 overflow-hidden flex flex-col">
  <a href={`/destinations/${hub.slug}`} class="block overflow-hidden aspect-[4/3] bg-gray-100 shrink-0">
    <SafeImage
      src={imagePath}
      fallback="/assets/images/placeholders/default-region.webp"
      alt={hub.name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
  </a>
  <div class="flex flex-col flex-1 p-5 gap-2">
    <a href={`/destinations/${hub.slug}`} class="block">
      <h3 class="font-display text-base font-semibold text-[#1e3a5f] leading-snug group-hover:text-[#1f4aa8] transition-colors duration-150">
        {hub.name}
      </h3>
    </a>
    <dl class="space-y-1 text-xs text-[rgba(15,23,42,0.65)]">
      <div><dt class="inline font-semibold text-[#1e3a5f]">Hub:</dt> <dd class="inline">{hub.name}</dd></div>
      <div><dt class="inline font-semibold text-[#1e3a5f]">Province:</dt> <dd class="inline">{provinceName}</dd></div>
    </dl>
  </div>
</article>
