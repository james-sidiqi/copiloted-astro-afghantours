---
import SectionHeader from '@components/ui/SectionHeader.astro';
import TourCard from '@components/travel/TourCard.astro';
import type { Tour } from '@lib/types/view-models';
import { isCustomTravelStyle } from '@lib/content/customAudiences';

interface Props {
  current: Tour;
  allTours: Tour[];
  limit?: number;
}

const { current, allTours, limit = 3 } = Astro.props;

function scoreRelated(candidate: Tour): number {
  if (!candidate.isActive || candidate.slug === current.slug) return -1;
  // Prefer scheduled peers when current is scheduled
  if (!isCustomTravelStyle(current.travelStyle) && isCustomTravelStyle(candidate.travelStyle)) {
    return -1;
  }
  let score = 0;
  const sharedProvinces = candidate.provinces.filter((p) => current.provinces.includes(p)).length;
  const sharedRegions = candidate.regions.filter((r) => current.regions.includes(r)).length;
  score += sharedProvinces * 3;
  score += sharedRegions * 2;
  if (candidate.travelStyle && candidate.travelStyle === current.travelStyle) score += 2;
  if (candidate.activityLevel && candidate.activityLevel === current.activityLevel) score += 1;
  if (current.durationDays && candidate.durationDays) {
    const delta = Math.abs(candidate.durationDays - current.durationDays);
    if (delta <= 3) score += 1;
  }
  if (candidate.isFeatured) score += 0.5;
  if (!isCustomTravelStyle(candidate.travelStyle)) score += 0.25;
  return score;
}

const related = allTours
  .map((tour) => ({ tour, score: scoreRelated(tour) }))
  .filter((entry) => entry.score > 0)
  .sort((a, b) => b.score - a.score || a.tour.name.localeCompare(b.tour.name))
  .slice(0, limit)
  .map((entry) => entry.tour);

const scheduledPool = allTours.filter(
  (tour) => tour.isActive && tour.slug !== current.slug && !isCustomTravelStyle(tour.travelStyle),
);

const fallback =
  related.length > 0
    ? related
    : scheduledPool
        .sort((a, b) => Number(b.isFeatured) - Number(a.isFeatured) || a.name.localeCompare(b.name))
        .slice(0, limit);
---

{fallback.length > 0 && (
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <SectionHeader
          eyebrow="Keep Exploring"
          title="Related Scheduled Tours"
          subtitle="Other set itineraries that share destinations, style, or pace — or inquire for a Custom Journey."
        />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {fallback.map((tour) => (
          <TourCard tour={tour} />
        ))}
      </div>
    </div>
  </section>
)}
