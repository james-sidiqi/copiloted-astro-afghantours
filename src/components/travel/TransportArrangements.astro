---
/**
 * Shared transport arrangements body — used by /getting-around/ and /transportation/.
 * WG1: keep both routes until host 301 cutover decides the single canonical URL.
 */
import SectionHeader from '@components/ui/SectionHeader.astro';
import TransportCard from '@components/travel/TransportCard.astro';
import ConversionCTA from '@components/travel/ConversionCTA.astro';
import SafeImage from '@components/ui/SafeImage.astro';
import { getSiteData } from '@lib/data/site-data';
import { firstExisting, resolveTransportAsset } from '@lib/getAssetUrl';

const data = getSiteData();
const transports = data.transports.filter((t) => t.isActive);

const tierOrder = ['budget', 'standard', 'premium', 'luxury', 'armored'];
const tierExplain: Record<string, string> = {
  budget: 'Cost-conscious options for suitable corridors and group sizes — allocated by capacity rules in our transport data.',
  standard: 'Default for most tours: private sedan, van, SUV, Toyota Coaster minibus, or Mercedes/Hino-class coach — matched to group size and corridor routes.',
  premium: 'Upgrade from Standard when comfort or longer drives warrant it — Additional cost, confirmed on inquiry.',
  luxury: 'Specialised vehicles (including armored where listed) — Additional cost on inquiry when the route and guest profile require them.',
  armored: 'Armored options when the itinerary and guest profile call for them — Additional cost, confirmed case by case, never assumed.',
};

const byTier = tierOrder
  .map((tier) => ({
    tier,
    blurb: tierExplain[tier] || '',
    items: transports.filter((t) => (t.tier || '').toLowerCase() === tier),
  }))
  .filter((g) => g.items.length > 0);

const roadSamples = [
  {
    label: 'Kabul–Jalalabad',
    path: firstExisting('/assets/images/transport/roads/kabul-jalalabad/01.webp', '/assets/images/transport/roads/kabul-jalalabad/02.webp'),
  },
  {
    label: 'Kabul–Salang',
    path: firstExisting('/assets/images/transport/roads/kabul-salang/01.webp'),
  },
  {
    label: 'Bamyan–Band-e-Amir',
    path: firstExisting('/assets/images/transport/roads/bamyan-band-e-amir/01.webp'),
  },
].filter((r) => r.path);

const mountainPath = firstExisting(
  '/assets/images/page-assets/travel/expedition-grade-mountain-access.webp',
  '/assets/images/page-assets/trust/mountain-access.webp',
);

---

<section class="py-12 bg-white border-b border-[#1e3a5f]/08">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-sm sm:text-base text-[rgba(15,23,42,0.75)] leading-relaxed space-y-4">
    <p>
      Transport is planned with the itinerary — not sold as a standalone rental catalogue. Categories below come from our operational
      ground-transport data: tier, vehicle type, passenger capacity, and routing notes.
    </p>
    <p>
      Standard is the default for most tours. Prefer a premium vehicle, a larger van, or a specialised option? That is an Additional cost — add it to your inquiry when you book a
      <strong class="text-[#1e3a5f]"> Scheduled Tour</strong> or request a
      <strong class="text-[#1e3a5f]"> Custom Journey</strong>.
    </p>
  </div>
</section>

<section class="py-12 bg-[#f6f7fb] border-y border-[#1e3a5f]/06">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-14">
    {byTier.map((group) => (
      <div>
        <div class="mb-6">
          <SectionHeader
            eyebrow="Vehicle category"
            title={group.tier.charAt(0).toUpperCase() + group.tier.slice(1)}
            subtitle={group.blurb}
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {group.items.map((transport) => <TransportCard transport={transport} />)}
        </div>
      </div>
    ))}

    {transports.length === 0 && (
      <p class="text-center py-12 text-gray-500">Transport categories coming soon.</p>
    )}
  </div>
</section>

{roadSamples.length > 0 && (
  <section class="py-14 bg-[#f7f3ea]/40 border-y border-[#1e3a5f]/06">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <SectionHeader
          eyebrow="Roads & corridors"
          title="Drive segments matter"
          subtitle="Sample corridor imagery from our transport library — realistic drive times and conditions are part of how we plan, not brochure decoration."
        />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {roadSamples.map((road) => (
          <figure class="rounded-2xl overflow-hidden bg-gray-100 shadow-sm">
            <div class="aspect-[16/10]">
              <SafeImage
                src={road.path}
                fallback="/assets/images/placeholders/default-card.webp"
                alt={road.label}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <figcaption class="px-4 py-3 text-sm font-medium text-[#1e3a5f]">{road.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}


{mountainPath && (
  <section class="py-14 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="aspect-[16/10] rounded-2xl overflow-hidden bg-gray-100 shadow-sm">
        <SafeImage
          src={mountainPath}
          fallback="/assets/images/placeholders/default-card.webp"
          alt="Mountain access vehicles on high-elevation routes"
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>
      <div>
        <SectionHeader
          eyebrow="Mountain access"
          title="Standard first — upgrades when the route needs them"
          subtitle="Most itineraries run on Standard vehicles. Premium, luxury, or mountain-capable upgrades are arranged when the corridor and season require them, at Additional cost confirmed in your inquiry — never invented as a package upsell."
        />
      </div>
    </div>
  </section>
)}

<ConversionCTA
  variant="band"
  eyebrow="Arrangements"
  title="Standard is default — request upgrades on inquiry (Additional cost)"
  subtitle="Tell us group size, preferred tier, and any specialised needs. We confirm what fits your Scheduled Tour dates or Custom Journey — we do not take stand-alone vehicle rentals here."
  primaryHref="/contact"
  primaryLabel="Inquire about transport"
  secondaryHref="/tours?type=scheduled"
  secondaryLabel="View Scheduled Tours"
/>
