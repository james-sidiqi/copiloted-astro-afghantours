---
import SafeImage from '@components/ui/SafeImage.astro';
import type { CustomAudience } from '@lib/content/customAudiences';

interface Props {
  audience: CustomAudience;
}

const { audience } = Astro.props;
const positionClass = audience.objectPosition || 'object-center';
---

<article class="group bg-white rounded-[14px] shadow-[0_2px_16px_0_rgba(0,0,0,0.08)] hover:shadow-[0_10px_30px_rgba(15,23,42,0.08)] transition-shadow duration-300 overflow-hidden flex flex-col">
  <a href={audience.href} class="block overflow-hidden aspect-[16/10] bg-gray-100 shrink-0">
    <SafeImage
      src={audience.imagePath}
      fallback="/assets/images/placeholders/default-tour.webp"
      alt={audience.label}
      class={`w-full h-full object-cover ${positionClass} group-hover:scale-105 transition-transform duration-500`}
      loading="lazy"
    />
  </a>
  <div class="flex flex-col flex-1 p-5 gap-3">
    <a href={audience.href} class="block">
      <h3 class="font-display text-lg font-semibold text-[#1e3a5f] leading-snug group-hover:text-[#1f4aa8] transition-colors duration-150">
        {audience.label}
      </h3>
    </a>
    <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed line-clamp-3 flex-1">
      {audience.blurb}
    </p>
    <div class="pt-2 border-t border-gray-100">
      <a href={audience.href} class="text-sm font-semibold text-[#b88a2a] hover:text-[#a07820] transition-colors">
        Inquire about this journey →
      </a>
    </div>
  </div>
</article>
