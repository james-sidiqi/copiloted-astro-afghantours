---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import SafeImage from '@components/ui/SafeImage.astro';
import ConversionCTA from '@components/travel/ConversionCTA.astro';
import { getAllActivities, activityHref, activityImage, hubsForActivity } from '@lib/content/activities';

const entries = await getAllActivities();
---

<BaseLayout
  title="Activities – Afghan Tours"
  description="Hiking, fishing, trekking, skiing, shopping, sightseeing, horse riding, and cycling — planned from operational hubs. Inspiration and planning context, not a bookable activity catalogue."
>
  <Hero
    title="Activities"
    subtitle="Ways to spend time around our operational hubs — when access and conditions allow. Activities support Scheduled Tours and Custom Journeys; they are not separate bookable products."
    imagePath="/assets/images/heroes/hero-destinations.webp"
    ctaText="View Scheduled Tours"
    ctaHref="/tours?type=scheduled"
  />

  <section class="py-16 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-10">
      <SectionHeader
        eyebrow="On the ground"
        title="Activities by interest"
        subtitle="Each activity links only to hubs in our locked matrix. We do not invent venues, prices, or schedule guarantees. Specialist logistics and Return Journeys stay on their own routes."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {entries.map((entry) => {
          const img = activityImage(entry.slug, entry.data.hero_image, entry.data.image);
          const hubs = hubsForActivity(entry.slug);
          return (
            <a
              href={activityHref(entry.slug)}
              class="group bg-white rounded-[14px] shadow-[0_2px_16px_0_rgba(0,0,0,0.08)] hover:shadow-[0_10px_30px_rgba(15,23,42,0.08)] transition-shadow duration-300 overflow-hidden flex flex-col"
            >
              <div class="aspect-[16/10] bg-gray-100 overflow-hidden shrink-0">
                <SafeImage
                  src={img}
                  fallback="/assets/images/placeholders/default-card.webp"
                  alt={entry.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-5 flex flex-col flex-1 gap-2">
                <span class="self-start text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#1e3a5f]/10 text-[#1e3a5f]">
                  Activity · {hubs.length} hub{hubs.length === 1 ? '' : 's'}
                </span>
                <h2 class="font-display text-base font-semibold text-[#1e3a5f] group-hover:text-[#1f4aa8] transition-colors">
                  {entry.data.title}
                </h2>
                {entry.data.card_description && (
                  <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed line-clamp-3">
                    {entry.data.card_description}
                  </p>
                )}
              </div>
            </a>
          );
        })}
      </div>

      <p class="text-sm text-[rgba(15,23,42,0.65)]">
        Looking for crafts, sport, and living traditions?
        <a href="/cultural-experiences/" class="text-[#1f4aa8] underline">Cultural Experiences</a>
        · Meals and food stops:
        <a href="/cultural-experiences/culinary/" class="text-[#1f4aa8] underline">Culinary Experiences</a>
      </p>
    </div>
  </section>

  <ConversionCTA
    variant="soft"
    title="Build these into a journey"
    subtitle="Tell us which activities matter — we plan from Kabul around current access, as Scheduled Tours or a Custom Journey."
  />
</BaseLayout>
