---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import SafeImage from '@components/ui/SafeImage.astro';
import ConversionCTA from '@components/travel/ConversionCTA.astro';
import RelatedScheduledTours from '@components/travel/RelatedScheduledTours.astro';
import {
  getAllActivities,
  activityHref,
  activityImage,
  listActivityGallery,
  hubsForActivity,
} from '@lib/content/activities';
import { hubHref } from '@lib/content/hubRelations';
import { toursFeaturingActivity } from '@lib/content/tourActivities';
import {
  buildActivityInquiryHref,
  buildActivityJourneyInquiryHref,
} from '@lib/inquiry';
import { getSiteData } from '@lib/data/site-data';

export async function getStaticPaths() {
  const entries = await getAllActivities();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const hero = activityImage(entry.slug, entry.data.hero_image, entry.data.image);
const gallery = listActivityGallery(entry.slug, entry.data.gallery || []);
const hubs = hubsForActivity(entry.slug);
const subtypes = entry.data.subtypes || [];
const askHref = buildActivityInquiryHref({ slug: entry.slug, name: entry.data.title });
const journeyHref = buildActivityJourneyInquiryHref({ slug: entry.slug, name: entry.data.title });
const site = getSiteData();
const featuringTours = toursFeaturingActivity(site.tours, entry.slug, 6);
---

<BaseLayout
  title={`${entry.data.title} – Activities – Afghan Tours`}
  description={entry.data.card_description || entry.data.subtitle || `Activity: ${entry.data.title}`}
>
  <div class="relative min-h-[320px] sm:min-h-[400px] flex items-end bg-[#1e3a5f]">
    <SafeImage
      src={hero}
      fallback="/assets/images/placeholders/default-card.webp"
      alt={entry.data.title}
      class="absolute inset-0 w-full h-full object-cover opacity-50"
      loading="eager"
    />
    <div class="relative z-10 max-w-6xl mx-auto w-full px-4 sm:px-6 py-12 text-white">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#b88a2a] mb-3">Activity</p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold">{entry.data.title}</h1>
      {entry.data.subtitle && <p class="mt-3 text-white/90 max-w-2xl text-base sm:text-lg">{entry.data.subtitle}</p>}
      <div class="mt-4 flex flex-wrap gap-3 text-xs sm:text-sm text-white/80">
        {entry.data.best_season && <span class="rounded-full bg-white/10 px-3 py-1">Season: {entry.data.best_season}</span>}
        {entry.data.duration && <span class="rounded-full bg-white/10 px-3 py-1">{entry.data.duration}</span>}
        {subtypes.slice(0, 4).map((s) => (
          <span class="rounded-full bg-white/10 px-3 py-1 capitalize">{s}</span>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={askHref}
          class="inline-flex items-center px-5 py-2.5 rounded-full bg-[#b88a2a] hover:bg-[#a07820] text-white text-sm font-semibold transition-colors"
        >
          Ask about this activity
        </a>
        <a
          href={journeyHref}
          class="inline-flex items-center px-5 py-2.5 rounded-full border border-white/70 hover:bg-white hover:text-[#1e3a5f] text-white text-sm font-semibold transition-colors"
        >
          Add to my journey
        </a>
      </div>
    </div>
  </div>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <div class="prose prose-slate prose-lg max-w-none prose-headings:font-display prose-headings:font-semibold prose-headings:text-[#1e3a5f] prose-h2:mt-10 prose-h2:mb-3 prose-h2:text-2xl prose-a:text-[#1f4aa8]">
      <Content />
    </div>

    {hubs.length > 0 && (
      <div class="mt-10 rounded-2xl border border-[#1e3a5f]/10 p-5">
        <SectionHeader
          eyebrow="Hubs"
          title="Where this activity is planned from"
          subtitle="Locked hub matrix only — availability depends on season and access. No schedule guarantees."
        />
        <ul class="mt-4 space-y-2 text-sm text-[rgba(15,23,42,0.8)]">
          {hubs.map((h) => (
            <li class="flex flex-wrap items-baseline gap-2">
              <a href={hubHref(h.hubSlug)} class="text-[#1f4aa8] hover:underline font-medium capitalize">
                {h.hubSlug.replace(/-/g, ' ')}
              </a>
              <span class="text-xs uppercase tracking-wide text-[rgba(15,23,42,0.45)]">{h.accessType}</span>
              {h.availabilityNote && <span class="text-xs text-[rgba(15,23,42,0.55)]">— {h.availabilityNote}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}

    {gallery.length > 0 && (
      <div class="mt-10 grid grid-cols-2 gap-3">
        {gallery.map((src) => (
          <SafeImage
            src={src}
            fallback="/assets/images/placeholders/default-card.webp"
            alt={entry.data.title}
            class="rounded-xl w-full h-40 object-cover"
            loading="lazy"
          />
        ))}
      </div>
    )}

    <p class="mt-8 text-sm">
      <a href="/activities/" class="text-[#1f4aa8] hover:underline">← All Activities</a>
    </p>
  </article>

  {featuringTours.length > 0 && (
    <RelatedScheduledTours
      tours={featuringTours}
      eyebrow="Scheduled Tours"
      title="Tours featuring this activity"
      subtitle="Only tours explicitly linked in our tour↔activity data. An activity is not a mini-tour — ask if you want this woven into a Custom Journey instead."
      limit={6}
    />
  )}

  <ConversionCTA
    variant="soft"
    title={`Ask about ${entry.data.title}`}
    subtitle="Standalone activity inquiry — no tour code required. We will say honestly whether this fits your dates and route."
    primaryHref={askHref}
    primaryLabel="Ask about this activity"
    secondaryHref={journeyHref}
    secondaryLabel="Add to my journey"
  />
</BaseLayout>
