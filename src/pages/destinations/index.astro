---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import HubCard from '@components/travel/HubCard.astro';
import ConversionCTA from '@components/travel/ConversionCTA.astro';
import ExperienceStrip from '@components/travel/ExperienceStrip.astro';
import { getSiteData } from '@lib/data/site-data';
import { resolveHubAsset } from '@lib/getAssetUrl';
import { getActivityCards } from '@lib/content/experienceCards';

const data = getSiteData();
const hubs = data.locations
  .filter((l) => l.type === 'destination' && l.isActive && l.isHub)
  .sort((a, b) => a.sortOrder - b.sortOrder);

const provinceByCode = new Map(data.provinces.map((p) => [p.provinceCode, p]));
const activityCards = getActivityCards(6);
---

<BaseLayout title="Destinations – Afghan Tours" description="Operational city hubs across Afghanistan — explore places we plan journeys around, then find a Scheduled Tour or inquire for Custom.">
  <Hero
    title="Destinations"
    subtitle="Operational city hubs we plan around — discover the map, then find a tour that fits."
    imagePath="/assets/images/heroes/hero-destinations.webp"
    ctaText="View Scheduled Tours"
    ctaHref="/tours?type=scheduled"
  />

  <section class="py-16 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <SectionHeader
          eyebrow="City Hubs"
          title="Travel hubs & provinces"
          subtitle="Each hub is shown with its province. Open a hub to see linked attractions, stays, and tours when our data connects them."
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hubs.map((hub) => {
          const province = provinceByCode.get(hub.parentCode);
          return (
            <HubCard
              hub={hub}
              provinceName={province ? `${province.provinceName} Province` : hub.parentCode}
              imagePath={resolveHubAsset(hub.slug, province?.squareImagePath || province?.coverImagePath || '', 'thumb') || province?.squareImagePath || province?.coverImagePath || ''}
            />
          );
        })}
      </div>
    </div>
  </section>

  <ExperienceStrip
    id="activities"
    cards={activityCards}
    eyebrow="Along the way"
    title="Activities that appear on journeys"
    subtitle="Sightseeing, markets, and seasonal activities from our asset library — not thin activity pages. Seasonal or specialised interests usually mean a Custom Journey inquiry."
  />

  <ConversionCTA
    variant="soft"
    eyebrow="Customer journey"
    title="Discover → find a tour → inquire"
    subtitle="Hubs and activities orient you. Next step: browse Scheduled Tours, or Build a Custom Journey if your route is specific."
  />
</BaseLayout>
