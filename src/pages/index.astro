---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import TourCard from '@components/travel/TourCard.astro';
import AudienceCard from '@components/travel/AudienceCard.astro';
import AttractionCard from '@components/travel/AttractionCard.astro';
import FaqAccordion from '@components/travel/FaqAccordion.astro';
import { getSiteData } from '@lib/data/site-data';
import { getCustomAudiences, isCustomTravelStyle } from '@lib/content/customAudiences';

const data = getSiteData();
const scheduledAll = data.tours.filter(t => t.isActive && !isCustomTravelStyle(t.travelStyle));
const catalogPriority = [
  'heart-of-the-silk-road',
  'weekend-in-kabul',
  'winter-circuit',
  'summer-circuit',
  'fall-eastern-afghanistan',
  'spring-afghanistan-tour',
  'buzkashi-expedition',
  'signature-afghan-tour'
];
const scheduledTours = [
  ...catalogPriority.map((slug) => scheduledAll.find((t) => t.slug === slug)).filter(Boolean),
  ...scheduledAll.filter((t) => !catalogPriority.includes(t.slug)),
].filter((t, i, arr) => arr.findIndex((x) => x!.slug === t!.slug) === i).slice(0, 8) as typeof scheduledAll;
const customAudiences = getCustomAudiences();
const featuredAttractions = data.attractions.filter(a => a.isActive && a.priority >= 5).slice(0, 6);
const homeFaqs = data.faqs.filter(f => f.isActive && f.pageAssignment === 'home').slice(0, 6);
---

<BaseLayout
  title="Afghan Tours – Afghanistan, Reimagined"
  description="Licensed Afghan tour operator based in Kabul. American-led, Afghan-operated. Scheduled tours, custom journeys, and practical planning around current access and conditions."
>
  <Hero
    title="Afghanistan, Reimagined"
    subtitle="Not the headlines. The hospitality. The history. The highlands."
    imagePath="/assets/images/heroes/hero-home.webp"
    videoSrc="/assets/images/heroes/home/hero.mp4"
    ctaText="Explore Tours"
    ctaHref="/tours"
    secondaryCtaText="Build My Journey"
    secondaryCtaHref="/contact"
  />

  <!-- Trust strip -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs sm:text-sm text-[rgba(15,23,42,0.7)]">
        <li>Licensed Afghan tour operator</li>
        <li class="hidden sm:inline text-gray-300" aria-hidden="true">·</li>
        <li>American-led, Afghan-operated</li>
        <li class="hidden sm:inline text-gray-300" aria-hidden="true">·</li>
        <li>Kabul-based</li>
        <li class="hidden sm:inline text-gray-300" aria-hidden="true">·</li>
        <li>LOI support for booked tours</li>
        <li class="hidden sm:inline text-gray-300" aria-hidden="true">·</li>
        <li>We do not issue visas</li>
      </ul>
    </div>
  </section>

  <!-- Scheduled Tours -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <SectionHeader
          eyebrow="Scheduled Tours"
          title="Proposed scheduled journeys from Kabul"
          subtitle="Proposed scheduled journeys for inquiry — set routes and windows we can cost and confirm with you. Custom journeys remain available when you need a different shape."
        />
      </div>
      {scheduledTours.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {scheduledTours.map(tour => <TourCard tour={tour} />)}
        </div>
      ) : (
        <p class="text-center text-gray-500 py-12">Tours coming soon.</p>
      )}
      <div class="mt-10 text-center">
        <a href="/tours?type=scheduled" class="inline-block px-8 py-3 rounded-full border-2 border-[#1e3a5f] text-[#1e3a5f] font-semibold hover:bg-[#1e3a5f] hover:text-white transition-all duration-200">
          View Scheduled Tours
        </a>
      </div>
    </div>
  </section>

  <!-- Custom Journeys -->
  <section class="py-20 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 text-center">
        <SectionHeader
          eyebrow="Custom Journeys"
          title="No fixed itinerary — inquiry-led"
          subtitle="Tell us your timing, interests, and group. We plan from Kabul around current access — for diaspora, veterans, Peace Corps alumni, business, artists, and media."
          centered
        />
      </div>
      {customAudiences.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {customAudiences.map(audience => <AudienceCard audience={audience} />)}
        </div>
      ) : null}
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/contact" class="inline-block px-8 py-3.5 rounded-full bg-[#b88a2a] hover:bg-[#a07820] text-white font-semibold shadow-md transition-all duration-200">
          Build My Journey
        </a>
        <a href="/tours?type=custom" class="inline-block px-8 py-3 rounded-full border-2 border-[#1e3a5f] text-[#1e3a5f] font-semibold hover:bg-[#1e3a5f] hover:text-white transition-all duration-200">
          Custom packages on Tours
        </a>
      </div>
    </div>
  </section>

  <!-- Explore the Country -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <SectionHeader
          eyebrow="Explore the Country"
          title="Places worth the drive"
          subtitle="From Band-e-Amir to Herat — destinations we actually operate to, planned around current conditions."
        />
      </div>
      {featuredAttractions.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredAttractions.map(attraction => <AttractionCard attraction={attraction} />)}
        </div>
      ) : (
        <p class="text-center text-gray-500 py-12">Attractions coming soon.</p>
      )}
      <div class="mt-10 text-center">
        <a href="/attractions" class="inline-block px-8 py-3 rounded-full border-2 border-[#1e3a5f] text-[#1e3a5f] font-semibold hover:bg-[#1e3a5f] hover:text-white transition-all duration-200">
          Explore Destinations
        </a>
      </div>
    </div>
  </section>

  <!-- Plan Your Trip / grounded why -->
  <section class="py-20 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-12 text-center">
        <SectionHeader eyebrow="Plan Your Trip" title="How we work from Kabul" centered />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center flex flex-col items-center gap-4 p-6 rounded-2xl bg-white">
          <div class="w-14 h-14 rounded-full bg-[#1e3a5f] flex items-center justify-center text-white">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-[#1e3a5f]">Locally rooted</h3>
          <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed">We plan from Kabul. We do not parachute in for the season. Routes, hotels, drivers, and permits are coordinated on the ground.</p>
        </div>
        <div class="text-center flex flex-col items-center gap-4 p-6 rounded-2xl bg-white">
          <div class="w-14 h-14 rounded-full bg-[#1e3a5f] flex items-center justify-center text-white">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-[#1e3a5f]">Safety is planned</h3>
          <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed">Your safety is planned, not promised. Route-aware timing, realistic drive times, current conditions, and adjustments when access changes.</p>
        </div>
        <div class="text-center flex flex-col items-center gap-4 p-6 rounded-2xl bg-white">
          <div class="w-14 h-14 rounded-full bg-[#1e3a5f] flex items-center justify-center text-white">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="font-display text-xl font-bold text-[#1e3a5f]">Honest hospitality</h3>
          <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed">Afghanistan is not a checkbox. It is a conversation — practical, human, and grounded in how travel here actually works.</p>
        </div>
      </div>
      <div class="mt-10 text-center flex flex-wrap justify-center gap-3">
        <a href="/safety" class="inline-block px-6 py-2.5 rounded-full border border-[#1e3a5f] text-[#1e3a5f] text-sm font-semibold hover:bg-[#1e3a5f] hover:text-white transition-all duration-200">Safety</a>
        <a href="/visa-entry" class="inline-block px-6 py-2.5 rounded-full border border-[#1e3a5f] text-[#1e3a5f] text-sm font-semibold hover:bg-[#1e3a5f] hover:text-white transition-all duration-200">Visa &amp; Entry</a>
        <a href="/contact" class="inline-block px-6 py-2.5 rounded-full border border-[#1e3a5f] text-[#1e3a5f] text-sm font-semibold hover:bg-[#1e3a5f] hover:text-white transition-all duration-200">Contact</a>
      </div>
    </div>
  </section>

  <!-- FAQ Teaser -->
  {homeFaqs.length > 0 && (
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="mb-10 text-center">
          <SectionHeader eyebrow="Common Questions" title="Frequently Asked Questions" centered />
        </div>
        <FaqAccordion faqs={homeFaqs} />
        <div class="mt-10 text-center">
          <a href="/faq" class="inline-block px-8 py-3 rounded-full border-2 border-[#1e3a5f] text-[#1e3a5f] font-semibold hover:bg-[#1e3a5f] hover:text-white transition-all duration-200">
            View All FAQs
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Contact CTA -->
  <section class="py-20 bg-[#1e3a5f]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center text-white">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-4">Ready to talk through a trip?</h2>
      <p class="text-white/80 text-lg mb-8">Scheduled tours, custom journeys, or a practical planning conversation — we are based in Kabul and happy to start there.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/tours" class="inline-block px-10 py-4 rounded-full bg-[#b88a2a] hover:bg-[#a07820] text-white font-semibold text-base shadow-lg transition-all duration-200">
          Explore Tours
        </a>
        <a href="/contact" class="inline-block px-10 py-4 rounded-full border-2 border-white/80 text-white font-semibold text-base hover:bg-white/10 transition-all duration-200">
          Contact AfghanTours
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
