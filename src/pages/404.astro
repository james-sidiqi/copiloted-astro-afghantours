---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found – Afghan Tours" description="The page you requested could not be found." noindex>
  <section class="min-h-[60vh] flex items-center justify-center bg-[#f6f7fb] px-4">
    <div class="max-w-lg text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-[#b88a2a] mb-3">404</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-[#1e3a5f] mb-4">Page not found</h1>
      <p class="text-[rgba(15,23,42,0.7)] leading-relaxed mb-8">That page does not exist or may have moved. Choose a section below to continue exploring Afghanistan.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="inline-block px-6 py-3 rounded-full bg-[#1e3a5f] hover:bg-[#16304f] text-white font-semibold transition-colors">Home</a>
        <a href="/tours" class="inline-block px-6 py-3 rounded-full border-2 border-[#1e3a5f] text-[#1e3a5f] font-semibold hover:bg-[#1e3a5f] hover:text-white transition-colors">Tours</a>
        <a href="/attractions" class="inline-block px-6 py-3 rounded-full border-2 border-[#1e3a5f] text-[#1e3a5f] font-semibold hover:bg-[#1e3a5f] hover:text-white transition-colors">Attractions</a>
        <a href="/contact" class="inline-block px-6 py-3 rounded-full bg-[#b88a2a] hover:bg-[#a07820] text-white font-semibold transition-colors">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
