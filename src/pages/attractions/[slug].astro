---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import SafeImage from '@components/ui/SafeImage.astro';
import ConversionCTA from '@components/travel/ConversionCTA.astro';
import RelatedScheduledTours from '@components/travel/RelatedScheduledTours.astro';
import type { Attraction } from '@lib/types/view-models';
import { getSiteData } from '@lib/data/site-data';
import { relatedScheduledByAttractionCode } from '@lib/content/relatedScheduled';

export async function getStaticPaths() {
  const data = getSiteData();
  return data.attractions.filter((attraction) => attraction.isActive).map((attraction) => ({
    params: { slug: attraction.slug },
    props: { attraction },
  }));
}

interface Props {
  attraction: Attraction;
}
const { attraction } = Astro.props;
const data = getSiteData();
const relatedTours = relatedScheduledByAttractionCode(
  data.tours,
  attraction.attractionCode,
  attraction.province || '',
  3,
);
---

<BaseLayout title={`${attraction.name} – Afghan Tours`} description={attraction.descShort || `Explore ${attraction.name}`}>
  <Hero
    title={attraction.name}
    subtitle={attraction.descShort || undefined}
    imagePath={attraction.imagePath || attraction.thumbnailPath || '/assets/images/placeholders/default-attraction.webp'}
  />

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-[minmax(0,1.5fr)_minmax(260px,0.8fr)] gap-10">
      <div>
        <SectionHeader eyebrow={attraction.category || 'Attraction'} title={attraction.name} />
        {attraction.descLong && (
          <p class="mt-4 text-[rgba(15,23,42,0.75)] leading-relaxed">{attraction.descLong}</p>
        )}
      </div>
      <aside class="bg-[#f6f7fb] rounded-2xl p-5 border border-[#1e3a5f]/10">
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 mb-4">
          <SafeImage
            src={attraction.imagePath || attraction.thumbnailPath}
            fallback="/assets/images/placeholders/default-attraction.webp"
            alt={attraction.name}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <dl class="space-y-2 text-sm text-[rgba(15,23,42,0.72)]">
          {attraction.province && (
            <div><dt class="inline font-semibold text-[#1e3a5f]">Province:</dt> <dd class="inline">{attraction.province} Province</dd></div>
          )}
          {attraction.category && (
            <div><dt class="inline font-semibold text-[#1e3a5f]">Category:</dt> <dd class="inline">{attraction.category}</dd></div>
          )}
        </dl>
      </aside>
    </div>
  </section>

  {relatedTours.length > 0 && (
    <RelatedScheduledTours
      tours={relatedTours}
      title="Scheduled tours that include this place"
      subtitle="Shown only when itinerary or attraction links exist in our data."
    />
  )}

  <ConversionCTA
    variant="soft"
    title="Include this on a journey"
    subtitle={relatedTours.length > 0
      ? 'Browse the linked Scheduled Tours above, or Build a Custom Journey if you need different timing or a focused visit.'
      : 'No scheduled itinerary currently lists this site in our data. Build a Custom Journey if you want it on your route — or browse other Scheduled Tours.'}
    primaryHref={relatedTours.length > 0 ? '/tours?type=scheduled' : '/contact'}
    primaryLabel={relatedTours.length > 0 ? 'View Scheduled Tours' : 'Build a Custom Journey'}
    secondaryHref={relatedTours.length > 0 ? '/contact' : '/tours?type=scheduled'}
    secondaryLabel={relatedTours.length > 0 ? 'Build a Custom Journey' : 'Browse Scheduled Tours'}
  />
</BaseLayout>
