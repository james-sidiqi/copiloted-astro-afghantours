---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import SafeImage from '@components/ui/SafeImage.astro';
import RelatedToursSection from '@components/travel/RelatedToursSection.astro';
import type { Attraction, SiteData } from '@lib/types/view-models';
import { getSiteData } from '@lib/data/site-data';

export async function getStaticPaths() {
  const data = getSiteData();
  return data.attractions.filter((attraction) => attraction.isActive).map((attraction) => ({
    params: { slug: attraction.slug },
    props: { attraction, data },
  }));
}

interface Props {
  attraction: Attraction;
  data: SiteData;
}
const { attraction, data } = Astro.props;

const relatedTours = data.tours.filter((tour) => {
  if (!tour.isActive) return false;
  const inItinerary = tour.itinerary.some((day) =>
    day.attractions.some((a) => a.attractionCode === attraction.attractionCode) ||
    day.attractionCodes.includes(attraction.attractionCode)
  );
  const inHighlights = tour.attractions.some((a) => a.attractionCode === attraction.attractionCode);
  const provinceMatch = attraction.province && tour.provinces.some((p) => p.toLowerCase() === attraction.province.toLowerCase());
  return inItinerary || inHighlights || provinceMatch;
}).slice(0, 6);
---

<BaseLayout title={`${attraction.name} – Afghan Tours`} description={attraction.descShort || `Explore ${attraction.name}`}>
  <Hero
    title={attraction.name}
    subtitle={attraction.descShort || undefined}
    imagePath={attraction.imagePath || attraction.thumbnailPath || '/assets/images/placeholders/default-attraction.webp'}
    ctaText="See Tours"
    ctaHref="/tours"
  />

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-[minmax(0,1.5fr)_minmax(260px,0.8fr)] gap-10">
      <div>
        <SectionHeader eyebrow={attraction.category || 'Cultural Experience'} title={attraction.name} />
        {attraction.descLong && (
          <p class="mt-4 text-[rgba(15,23,42,0.75)] leading-relaxed">{attraction.descLong}</p>
        )}
      </div>
      <aside class="bg-[#f6f7fb] rounded-2xl p-5 border border-[#1e3a5f]/10">
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 mb-4">
          <SafeImage
            src={attraction.thumbnailPath || attraction.imagePath}
            fallback="/assets/images/placeholders/default-attraction.webp"
            alt={attraction.name}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <dl class="space-y-2 text-sm text-[rgba(15,23,42,0.72)]">
          {attraction.province && (
            <div><dt class="inline font-semibold text-[#1e3a5f]">Province:</dt> <dd class="inline">{attraction.province} Province</dd></div>
          )}
          {attraction.category && (
            <div><dt class="inline font-semibold text-[#1e3a5f]">Category:</dt> <dd class="inline">{attraction.category}</dd></div>
          )}
        </dl>
      </aside>
    </div>
  </section>

  <section class="py-12 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <RelatedToursSection
        tours={relatedTours}
        title={`Tours related to ${attraction.name}`}
        eyebrow="Cultural Experience"
        contextLabel={attraction.name}
        emptyHint="No published tours currently list this attraction. Request a custom itinerary."
      />
    </div>
  </section>
</BaseLayout>
