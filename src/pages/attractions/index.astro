---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import AttractionCard from '@components/travel/AttractionCard.astro';
import { getSiteData } from '@lib/data/site-data';

const data = getSiteData();
const attractions = data.attractions
  .filter(a => a.isActive)
  .sort((a, b) => b.priority - a.priority || a.name.localeCompare(b.name));
---

<BaseLayout title="Attractions – Afghan Tours" description="Explore Afghanistan's iconic attractions, landscapes, historic sites, and cultural highlights.">
  <Hero title="Attractions of Afghanistan" subtitle="Landscapes, history, and culture across every region of the country" imagePath="/assets/images/heroes/hero-destinations.webp" ctaText="Plan Your Trip" ctaHref="/contact" />
  <section class="py-20 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10"><SectionHeader eyebrow="Highlights" title="Places Worth the Journey" subtitle="Explore the places featured across our guided itineraries." /></div>
      {attractions.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {attractions.map(attraction => <AttractionCard attraction={attraction} />)}
        </div>
      ) : (
        <div class="text-center py-20 text-gray-500"><p class="text-lg font-medium">Attractions coming soon.</p></div>
      )}
    </div>
  </section>
</BaseLayout>
