---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import AttractionCard from '@components/travel/AttractionCard.astro';
import { buildSiteData } from '@lib/data/buildRelations';

const data = buildSiteData();
const attractions = data.attractions.filter((attraction) => attraction.isActive);
---

<BaseLayout title="Attractions – Afghan Tours" description="Browse Afghanistan's key attractions by region and province.">
  <Hero
    title="Attractions"
    subtitle="Ancient cities, mountain landscapes, mosques, forts, and living heritage"
    imagePath="/assets/images/heroes/hero-destinations.webp"
    ctaText="Plan a Tour"
    ctaHref="/tours"
  />

  <section class="py-16 bg-[#f6f7fb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <SectionHeader
          eyebrow="Explore"
          title="Afghanistan Attractions"
          subtitle="All attractions use verified data links and safe image fallbacks."
        />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {attractions.map((attraction) => <AttractionCard attraction={attraction} />)}
      </div>
    </div>
  </section>
</BaseLayout>
