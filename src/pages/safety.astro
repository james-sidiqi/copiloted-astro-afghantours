---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import FaqAccordion from '@components/travel/FaqAccordion.astro';
import { getSiteData } from '@lib/data/site-data';

const data = getSiteData();
const safetyFaqs = data.faqs.filter(f => f.isActive && f.pageAssignment.toLowerCase().includes('safety'));

const pillars = [
  {
    title: 'Route-aware planning',
    desc: 'Itineraries are built around current access, timing, permits, hotels, drivers, and conditions — then adjusted when those change. We work with local partners who know the roads and the calendar.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Local coordination',
    desc: 'Guides, drivers, and hosts are coordinated from Kabul. Clear check-ins, realistic drive times, and on-the-ground judgment — not a script written abroad.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Permits, docs & suitability',
    desc: 'We account for permits and documents, hotel and transport suitability for the route, and contingency options when a segment is no longer workable.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Guest briefing & conduct',
    desc: 'Before departure we brief guests on expected behaviour, cultural sensitivities, and practical guidelines. Responsible conduct is part of how every tour stays workable.',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
];
---

<BaseLayout
  title="Safety – Afghan Tours | Planned, Not Promised"
  description="How Afghan Tours plans safety from Kabul: route-aware timing, local coordination, permits, current conditions, and honest adjustments — not guarantees."
>
  <Hero
    title="Safety"
    subtitle="Your safety is planned, not promised."
    imagePath="/assets/images/heroes/hero-safety.webp"
    ctaText="Contact Us"
    ctaHref="/contact"
  />

  <!-- Commitment section -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <SectionHeader eyebrow="Safety" title="Practical planning, honest limits" />
      </div>
      <div class="text-[rgba(15,23,42,0.75)] leading-relaxed space-y-5 text-base">
        <p>Travel in Afghanistan needs careful planning, clear information, and people who are actually based here. We do not say Afghanistan is safe, risk-free, or guaranteed. We plan routes around current access and conditions — and we change plans when those change.</p>
        <p>If a route, hotel, or timing is not workable, we modify or postpone. Guest and team wellbeing comes before keeping a brochure itinerary intact.</p>
      </div>
    </div>
  </section>

  <!-- Safety Pillars -->
  <section class="py-20 bg-[#f6f7fb]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-12 text-center">
        <SectionHeader eyebrow="How We Plan" title="What planning looks like" centered />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pillars.map((pillar) => (
          <div class="bg-white rounded-2xl shadow-sm p-6 flex gap-5">
            <div class="w-12 h-12 rounded-xl bg-[#1e3a5f] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={pillar.icon} />
              </svg>
            </div>
            <div>
              <h3 class="font-display text-base font-bold text-[#1e3a5f] mb-2">{pillar.title}</h3>
              <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed">{pillar.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Safety FAQs -->
  {safetyFaqs.length > 0 && (
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="mb-10 text-center">
          <SectionHeader eyebrow="Your Questions" title="Safety FAQs" centered />
        </div>
        <FaqAccordion faqs={safetyFaqs} />
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 bg-[#1e3a5f]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center text-white">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-4">Questions about conditions?</h2>
      <p class="text-white/80 mb-8">Ask about routes, timing, and what is currently workable — then browse Scheduled Tours or inquire for a Custom Journey.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-block px-8 py-3.5 rounded-full bg-[#b88a2a] hover:bg-[#a07820] text-white font-semibold shadow-lg transition-all duration-200">
          Ask about conditions
        </a>
        <a href="/tours?type=scheduled" class="inline-block px-8 py-3.5 rounded-full border-2 border-white/80 hover:bg-white hover:text-[#1e3a5f] text-white font-semibold transition-all duration-200">
          View Scheduled Tours
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
