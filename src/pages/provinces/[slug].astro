---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import AttractionCard from '@components/travel/AttractionCard.astro';
import TourCard from '@components/travel/TourCard.astro';
import ConversionCTA from '@components/travel/ConversionCTA.astro';
import { isCustomTravelStyle } from '@lib/content/customAudiences';
import type { Province } from '@lib/types/view-models';
import { getSiteData } from '@lib/data/site-data';

export async function getStaticPaths() {
  const data = getSiteData();
  return data.provinces.map(p => ({
    params: { slug: p.provinceSlug },
    props: { province: p },
  }));
}

interface Props { province: Province; }
const { province } = Astro.props;
const scheduledInProvince = province.tours.filter(t => t.isActive && !isCustomTravelStyle(t.travelStyle));
---

<BaseLayout title={`${province.provinceName} Province – Afghan Tours`} description={province.shortBlurb || `Explore ${province.provinceName} province, Afghanistan.`}>
  <Hero
    title={province.provinceName}
    subtitle={province.shortBlurb || undefined}
    imagePath={province.coverImagePath || undefined}
    ctaText="Plan a Visit"
    ctaHref="/contact"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 space-y-16">
    <!-- About -->
    {province.fullBlurb && (
      <section>
        <div class="mb-6">
          <SectionHeader eyebrow={province.region} title={`About ${province.provinceName}`} />
        </div>
        <div class="prose prose-lg max-w-none text-[rgba(15,23,42,0.75)] leading-relaxed">
          <p>{province.fullBlurb}</p>
        </div>
      </section>
    )}

    <!-- Attractions -->
    {province.attractions.filter(a => a.isActive).length > 0 && (
      <section>
        <div class="mb-8">
          <SectionHeader eyebrow="Highlights" title={`Attractions in ${province.provinceName}`} />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {province.attractions.filter(a => a.isActive).map(attraction => <AttractionCard attraction={attraction} />)}
        </div>
      </section>
    )}

    <!-- Scheduled tours linked in data -->
    {scheduledInProvince.length > 0 && (
      <section>
        <div class="mb-8">
          <SectionHeader eyebrow="Scheduled Tours" title={`Scheduled tours through ${province.provinceName}`} subtitle="Only itineraries linked to this province in our data." />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {scheduledInProvince.map(tour => <TourCard tour={tour} />)}
        </div>
      </section>
    )}
  </div>

  <ConversionCTA
    variant="soft"
    title={`Plan time in ${province.provinceName}`}
    subtitle={scheduledInProvince.length > 0
      ? 'Browse linked Scheduled Tours above, or Build a Custom Journey for a different route or timing.'
      : 'No scheduled itinerary currently lists this province. Build a Custom Journey if you want it on your route — or browse other Scheduled Tours.'}
    primaryHref={scheduledInProvince.length > 0 ? '/tours?type=scheduled' : '/contact'}
    primaryLabel={scheduledInProvince.length > 0 ? 'View Scheduled Tours' : 'Build a Custom Journey'}
    secondaryHref={scheduledInProvince.length > 0 ? '/contact' : '/tours?type=scheduled'}
    secondaryLabel={scheduledInProvince.length > 0 ? 'Build a Custom Journey' : 'Browse Scheduled Tours'}
  />
</BaseLayout>
