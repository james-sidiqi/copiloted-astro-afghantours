---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { siteConfig } from '@lib/config';
---

<BaseLayout title="Contact Us – Afghan Tours" description="Contact James Tourist & Travel Agency (Afghan Tours). We respond within 24 hours.">
  <Hero title="Contact Us" subtitle="Operational planning support for tours across Afghanistan" imagePath="/assets/images/heroes/hero-contact.webp" />
  <section class="py-20 bg-[#f6f7fb]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="space-y-8">
          <div>
            <SectionHeader eyebrow="Get in Touch" title="We're Here to Help" />
            <p class="mt-4 text-[rgba(15,23,42,0.75)] leading-relaxed">
              Whether you need a published itinerary confirmed or a custom expedition scoped — tell us your dates, group size, and hubs of interest. We typically respond within 24 hours.
            </p>
          </div>

          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-[#1e3a5f] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-[#1e3a5f] text-sm">Email</p>
                <a href={`mailto:${siteConfig.email}`} class="text-[#1f4aa8] hover:underline text-sm">{siteConfig.email}</a>
                <p class="text-xs text-[rgba(15,23,42,0.5)] mt-0.5">We respond within 24 hours</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-[#1e3a5f] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-[#1e3a5f] text-sm">Phone / WhatsApp</p>
                <a href={siteConfig.phone.url} class="text-[#1f4aa8] hover:underline text-sm">{siteConfig.phone.display}</a>
                <p class="text-xs text-[rgba(15,23,42,0.5)] mt-0.5">Quickest channel for planning</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl border border-[#1e3a5f]/10 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#b88a2a] mb-1">Office</p>
            <h2 class="font-display text-lg font-bold text-[#1e3a5f]">{siteConfig.office.heading}</h2>
            <p class="mt-2 text-sm text-[rgba(15,23,42,0.75)] leading-relaxed">{siteConfig.office.address}</p>
            <p class="mt-2 text-xs text-[rgba(15,23,42,0.55)]">License {siteConfig.license} · Operated as {siteConfig.name}</p>
            <a
              href={siteConfig.office.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-[#1e3a5f] hover:bg-[#16304f] text-white text-sm font-semibold shadow-sm transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {siteConfig.office.mapsLabel}
            </a>
          </div>

          <div class="bg-[#1e3a5f]/5 rounded-2xl p-5 border border-[#1e3a5f]/10">
            <p class="text-sm font-semibold text-[#1e3a5f] mb-1">Planning notes</p>
            <ul class="text-sm text-[rgba(15,23,42,0.7)] space-y-1.5 list-disc list-inside">
              <li>Letter of Invitation (LOI) on every booked tour</li>
              <li>We do not issue visas</li>
              <li>4WD is standard; armored vehicles are premium on request</li>
              <li>Your safety is planned, not promised — routes can change</li>
            </ul>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-[0_2px_20px_rgba(0,0,0,0.08)] p-8">
          <h2 class="font-display text-xl font-bold text-[#1e3a5f] mb-2">Send an Enquiry</h2>
          <p class="text-sm text-[rgba(15,23,42,0.65)] mb-6">Fill the form — we’ll open WhatsApp with your details prefilled for the fastest reply.</p>

          <form id="enquiry-form" class="space-y-4" novalidate>
            <div>
              <label for="name" class="block text-sm font-semibold text-[#1e3a5f] mb-1.5">Your Name *</label>
              <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4aa8]" />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-[#1e3a5f] mb-1.5">Email *</label>
              <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4aa8]" />
            </div>
            <div>
              <label for="whatsapp" class="block text-sm font-semibold text-[#1e3a5f] mb-1.5">WhatsApp number</label>
              <input type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" placeholder="+93 …" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4aa8]" />
            </div>
            <div>
              <label for="interest" class="block text-sm font-semibold text-[#1e3a5f] mb-1.5">Destination / tour interest</label>
              <input type="text" id="interest" name="interest" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4aa8]" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="dates" class="block text-sm font-semibold text-[#1e3a5f] mb-1.5">Preferred dates</label>
                <input type="text" id="dates" name="dates" placeholder="e.g. May 2027" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4aa8]" />
              </div>
              <div>
                <label for="group_size" class="block text-sm font-semibold text-[#1e3a5f] mb-1.5">Group size</label>
                <input type="text" id="group_size" name="group_size" placeholder="e.g. 2–4" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4aa8]" />
              </div>
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-[#1e3a5f] mb-1.5">Message *</label>
              <textarea id="message" name="message" required rows="4" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm resize-y focus:outline-none focus:ring-2 focus:ring-[#1f4aa8]"></textarea>
            </div>
            <button type="submit" class="w-full py-3.5 rounded-full bg-[#25d366] hover:bg-[#1ebe57] text-white font-semibold text-sm shadow-md transition-colors">
              Continue on WhatsApp
            </button>
            <a id="email-fallback" href={`mailto:${siteConfig.email}?subject=Afghan%20Tours%20enquiry`} class="block w-full text-center py-3 rounded-full border-2 border-[#1e3a5f] text-[#1e3a5f] font-semibold text-sm hover:bg-[#1e3a5f] hover:text-white transition-colors">
              Or email {siteConfig.email}
            </a>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const WA_NUMBER = '93780123456';
  const form = document.getElementById('enquiry-form');
  const params = new URLSearchParams(window.location.search);
  const type = params.get('type') || '';
  const interestParam = params.get('interest') || params.get('tour') || '';
  const interestInput = document.getElementById('interest');
  const messageInput = document.getElementById('message');

  if (interestInput instanceof HTMLInputElement && interestParam) {
    interestInput.value = interestParam.replace(/-/g, ' ');
  }
  if (messageInput instanceof HTMLTextAreaElement && (type === 'custom-tour' || type === 'tour')) {
    messageInput.value = interestParam
      ? `Hello — I'd like to enquire about: ${interestParam.replace(/-/g, ' ')}.`
      : "Hello — I'd like to request a custom tour. Here are my preferences:";
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const whatsapp = String(data.get('whatsapp') || '').trim();
    const interest = String(data.get('interest') || '').trim();
    const dates = String(data.get('dates') || '').trim();
    const groupSize = String(data.get('group_size') || '').trim();
    const message = String(data.get('message') || '').trim();

    if (!name || !email || !message) {
      form.reportValidity();
      return;
    }

    const lines = [
      `Afghan Tours enquiry${type ? ` (${type})` : ''}`,
      `Name: ${name}`,
      `Email: ${email}`,
      whatsapp ? `WhatsApp: ${whatsapp}` : '',
      interest ? `Interest: ${interest}` : '',
      dates ? `Dates: ${dates}` : '',
      groupSize ? `Group size: ${groupSize}` : '',
      '',
      message,
    ].filter(Boolean);

    const url = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>
