---
/**
 * Legacy /Getting Around/ route. Prefer /transportation/ (live URL).
 * Host cutover: 301 /getting-around/ → /transportation/ (see docs/redirect-map.csv).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import TransportArrangements from '@components/travel/TransportArrangements.astro';
import { resolveTransportAsset } from '@lib/getAssetUrl';
---

<BaseLayout
  title="Getting Around – Afghan Tours"
  description="How Afghan Tours moves guests on tours — vehicle categories, capacity, and when upgrades apply. Inquire for premium or specialised transport."
>
  <Hero
    title="Getting around"
    subtitle="How we move guests on tours — vehicle categories matched to route, group size, and conditions. Same content as Transportation."
    imagePath={resolveTransportAsset('standard', 'suv', 'hero') || '/assets/images/heroes/hero-destinations.webp'}
    ctaText="Inquire about transport"
    ctaHref="/contact"
  />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-6">
    <p class="text-sm text-[rgba(15,23,42,0.65)] bg-[#f6f7fb] border border-[#1e3a5f]/10 rounded-xl px-4 py-3">
      This page mirrors <a class="text-[#1e3a5f] font-semibold underline" href="/transportation/">Transportation</a>
      (the live URL). After cutover, expect a host-level 301 from <code>/getting-around/</code> → <code>/transportation/</code>.
    </p>
  </div>

  <TransportArrangements />
</BaseLayout>
