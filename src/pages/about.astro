---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/site/Hero.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { siteConfig } from '@lib/config';
---

<BaseLayout title="About Afghan Tours" description="James Tourist & Travel Agency operates Afghan Tours — an American-led, Kabul-based expedition operator.">
  <Hero
    title="About Afghan Tours"
    subtitle="American-led. Kabul-based. Operationally grounded."
    imagePath="/assets/images/heroes/hero-about.webp"
    ctaText="Contact Us"
    ctaHref="/contact"
  />

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <SectionHeader eyebrow="Our Story" title="Who We Are" />
      </div>
      <div class="prose prose-lg max-w-none text-[rgba(15,23,42,0.75)] leading-relaxed space-y-5">
        <p>
          <strong>{siteConfig.name}</strong> is the public brand of
          <strong> {siteConfig.legalName}</strong>, a licensed Afghan tour operator
          (License {siteConfig.license}) based in Kabul and American-led.
        </p>
        <p>
          We plan calm, logistics-aware expeditions across Afghanistan’s operational hubs. We do not invent access, and we do not call Afghanistan safe — your safety is planned, not promised. Routes can change.
        </p>
        <p>
          Every booked tour includes a Letter of Invitation (LOI). We do not issue visas. 4WD is standard; armored vehicles are available as a premium on request, not as the default.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-[#f6f7fb]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-12 text-center">
        <SectionHeader eyebrow="The Team" title="Meet the People Behind Afghan Tours" centered />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl shadow-sm p-6 text-center flex flex-col items-center gap-4">
          <img
            src="/assets/images/about/president.webp"
            alt="James (Amir) Sidiqi"
            class="w-20 h-20 rounded-full object-cover object-center"
            loading="lazy"
            onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#1e3a5f] to-[#1f4aa8] flex items-center justify-center text-white font-display text-2xl font-bold" style="display:none">JS</div>
          <div>
            <h3 class="font-display text-lg font-bold text-[#1e3a5f]">James “Amir” Sidiqi</h3>
            <p class="text-[#b88a2a] text-sm font-semibold mt-0.5">Operations Lead</p>
          </div>
          <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed">American-led operations from Kabul, with deep provincial networks and expedition planning experience.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm p-6 text-center flex flex-col items-center gap-4">
          <img
            src="/assets/images/about/vice-president.webp"
            alt="Mohammad (Edrees) Rahimi"
            class="w-20 h-20 rounded-full object-cover object-center"
            loading="lazy"
            onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#1e3a5f] to-[#1f4aa8] flex items-center justify-center text-white font-display text-2xl font-bold" style="display:none">MR</div>
          <div>
            <h3 class="font-display text-lg font-bold text-[#1e3a5f]">Mohammad “Edrees” Rahimi</h3>
            <p class="text-[#b88a2a] text-sm font-semibold mt-0.5">Local Guide & Operations</p>
          </div>
          <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed">Ground logistics, guiding, and local coordination across hubs and routes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-12 text-center">
        <SectionHeader eyebrow="Our Difference" title="Why Travel With Afghan Tours" centered />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          { title: 'Licensed & Accountable', desc: `Operated by ${siteConfig.legalName} under license ${siteConfig.license}.` },
          { title: 'Hub-Based Planning', desc: 'Itineraries built around operational hubs — KBLC, BMYC, MAZC, HERC, KDRC, JBDC, FAIC, GHZC.' },
          { title: 'Planned, Not Promised', desc: 'Intelligence-aware routing. Conditions change; we adjust. We never call Afghanistan safe.' },
          { title: 'Small-Group & Custom', desc: 'Published tours plus custom expeditions scoped to your dates, group size, and access.' },
        ].map(item => (
          <div class="flex gap-4 p-5 bg-[#f6f7fb] rounded-xl">
            <div class="w-8 h-8 rounded-full bg-[#1e3a5f] flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <h4 class="font-semibold text-[#1e3a5f] mb-1">{item.title}</h4>
              <p class="text-sm text-[rgba(15,23,42,0.7)] leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-8 text-center">
        <SectionHeader eyebrow="Credentials" title="Licensed & Certified" centered />
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-8 justify-center">
        <img
          src="/assets/images/about/jtt-license.webp"
          alt={`${siteConfig.legalName} license`}
          class="w-full sm:w-64 rounded-xl shadow-md object-contain"
          loading="lazy"
        />
        <div class="max-w-sm text-center sm:text-left">
          <p class="text-[rgba(15,23,42,0.75)] leading-relaxed text-sm">
            {siteConfig.legalName} operates under tourism license <strong>{siteConfig.license}</strong>. Public brand: {siteConfig.name}. Office: {siteConfig.office.address}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#1e3a5f]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center text-white">
      <h2 class="font-display text-2xl sm:text-3xl font-bold mb-4">Ready to Travel With Us?</h2>
      <p class="text-white/80 mb-8">Get in touch and let’s start planning your expedition.</p>
      <a href="/contact" class="inline-block px-8 py-3.5 rounded-full bg-[#b88a2a] hover:bg-[#a07820] text-white font-semibold shadow-lg transition-all duration-200">
        Contact Us
      </a>
    </div>
  </section>
</BaseLayout>
